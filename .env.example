# Copy to .env and fill in real values. Never commit .env.
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string
GITHUB_TOKEN=ghp_your_classic_pat_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# LLM provider: "gemini" (default) or "groq"; Groq ignores GEMINI_* and vice versa
LLM_PROVIDER=gemini
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MAX_FILES_PER_PR=20
MAX_LINES_PER_FILE=800
GITHUB_MAX_LINES=3000
# Lowest severity posted as an inline comment: LOW, MEDIUM, HIGH or CRITICAL.
# Findings below the threshold are still saved to the DB and counted in the
# PR summary comment. Invalid values fall back to LOW with a warning.
MIN_SEVERITY=LOW
DATABASE_PATH=reviews.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
DEBUG=True
